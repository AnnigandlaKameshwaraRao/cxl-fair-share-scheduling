+# We need a DDR4-like memory device. The channel count (pool bandwidth) can be
+# set per run with "pool-channels" in host 0's metadata; default 4.
+pool_channels = int(jobs["0"]["metadata"].get("pool-channels", "4") or "4")
+print("pool channels:", pool_channels)
+# BTP: per-bank DRAM scheduling of the pool channel, set per run with "pool-sched"
+# in host 0's metadata (needs libbtpmem.so in ext/sst for anything but "fcfs"):
+#   fcfs      stock memHierarchy.timingDRAM: FIFO bank queues, closed page (Phase 1)
+#   frfcfs    btpmem.timingDRAM, lazy pop, FR-FCFS bank queues, open page
+#   fcfs-open btpmem.timingDRAM, lazy pop, FIFO bank queues, open page
+#   fcfs-copy btpmem.timingDRAM in stock mode (eager pop, FIFO, closed page), for
+#             checking the copy against stock and counting row hits
+# "pool-rowhit-cap" (frfcfs only): consecutive row hits that may bypass an older
+# request before the oldest is served; 0 = no cap.
+pool_sched = jobs["0"]["metadata"].get("pool-sched", "fcfs") or "fcfs"
+pool_rowhit_cap = int(jobs["0"]["metadata"].get("pool-rowhit-cap", "0") or "0")
+print("pool scheduler:", pool_sched, "row-hit cap:", pool_rowhit_cap)
+sched_params = {
+    "fcfs": {},
+    "frfcfs": {"channel.rank.bank.lazyPop": 1,
+               "channel.rank.bank.transactionQ": "btpmem.frfcfsTransactionQ",
+               "channel.rank.bank.transactionQ.maxRowHits": pool_rowhit_cap,
+               "channel.rank.bank.pagePolicy.close": 0},
+    "fcfs-open": {"channel.rank.bank.lazyPop": 1,
+                  "channel.rank.bank.pagePolicy.close": 0},
+    "fcfs-copy": {},
+}[pool_sched]
+backend = "memHierarchy.timingDRAM" if pool_sched == "fcfs" else "btpmem.timingDRAM"
+memory = memctrl.setSubComponent( "backend", backend)
+memory.addParams(sched_params)
 memory.addParams({
     "id" : 0,
     "addrMapper" : "memHierarchy.simpleAddrMapper",
@@ -215,12 +242,41 @@ memory.addParams({
