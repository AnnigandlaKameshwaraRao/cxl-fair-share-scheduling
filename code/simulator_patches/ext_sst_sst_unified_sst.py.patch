 })
+# BTP: DRAM row (page) size of the pool, set per run with "pool-row-size" in host 0's
+# metadata, e.g. "8KiB" (DDR4 rank) or "4KiB" (DDR5 x8/x16 subchannel). Empty keeps
+# simpleAddrMapper, whose rows are 16 KiB whatever row_size says (Phase 1).
+pool_row_size = jobs["0"]["metadata"].get("pool-row-size", "") or ""
+print("pool row size:", pool_row_size or "16KiB (simpleAddrMapper)")
+if pool_row_size:
+    memory.addParams({"addrMapper" : "btpmem.rowAddrMapper",
+                      "addrMapper.row_size" : pool_row_size})
+# BTP: per-host front end of the pool (btpmem.timingDRAM "arb"), set per run in host 0's
+# metadata. Empty "pool-arb" keeps the stock front end (all O3 runs).
+#   pool-arb         scheduler: fcfs | frfcfs (oldest first across hosts, no host priority);
+#                    static (fixed host ranks, pool-arb-params {"ranks": "1,1,1,0"}, lower first);
+#                    bliss | atlas | tcm | parbs | saa (see btp-sst/btpmem/btpSched.cc for settings)
+#   pool-arb-level   where host priority acts: both (default) | admit | bank
+#   pool-arb-params  scheduler settings, a dict (or JSON string); each key is passed as arb.<key>
+pool_arb = jobs["0"]["metadata"].get("pool-arb", "") or ""
+if pool_arb:
+    if backend != "btpmem.timingDRAM":
+        raise SystemExit("pool-arb needs a btpmem pool-sched (frfcfs, fcfs-open, fcfs-copy), not '%s'" % pool_sched)
+    pool_arb_level = jobs["0"]["metadata"].get("pool-arb-level", "both") or "both"
+    pool_arb_params = jobs["0"]["metadata"].get("pool-arb-params", {}) or {}
+    if isinstance(pool_arb_params, str):
+        pool_arb_params = json.loads(pool_arb_params)
+    arb = {"arb": 1, "arb.scheduler": pool_arb, "arb.level": pool_arb_level,
+           "arb.num_hosts": system_nodes, "arb.host_shift": 30}
+    for k, v in pool_arb_params.items():
+        arb["arb." + k] = v
+    memory.addParams(arb)
+print("pool front end:", ("per-host, " + pool_arb + ", level " + pool_arb_level) if pool_arb else "stock")
 
